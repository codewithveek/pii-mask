{
  "name": "@pii-mask/cli",
  "version": "0.2.0",
  "description": "CLI tool for masking PII in files. Wraps @pii-mask/core.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewithveek/pii-mask.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/codewithveek/pii-mask/issues"
  },
  "homepage": "https://github.com/codewithveek/pii-mask/tree/main/packages/cli#readme",
  "keywords": [
    "pii",
    "mask",
    "cli",
    "redact",
    "anonymize",
    "privacy",
    "data-protection",
    "command-line"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pii-mask": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@pii-mask/core": "workspace:*",
    "citty": "^0.2.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
