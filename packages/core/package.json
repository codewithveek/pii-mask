{
  "name": "@pii-mask/core",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lexicon/africa": {
      "types": "./dist/lexicon/africa.d.ts",
      "import": "./dist/lexicon/africa.js",
      "require": "./dist/lexicon/africa.cjs"
    },
    "./lexicon/south-asia": {
      "types": "./dist/lexicon/south-asia.d.ts",
      "import": "./dist/lexicon/south-asia.js",
      "require": "./dist/lexicon/south-asia.cjs"
    },
    "./lexicon/east-asia": {
      "types": "./dist/lexicon/east-asia.d.ts",
      "import": "./dist/lexicon/east-asia.js",
      "require": "./dist/lexicon/east-asia.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "libphonenumber-js": "^1.12.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  },
  "peerDependencies": {
    "@faker-js/faker": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    }
  }
}
