{
  "name": "@pii-mask/core",
  "version": "0.1.0",
  "description": "Zero-dependency PII masking engine with detector registry, all modes, and all detectors.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewithveek/pii-mask.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/codewithveek/pii-mask/issues"
  },
  "homepage": "https://github.com/codewithveek/pii-mask/tree/main/packages/core#readme",
  "keywords": [
    "pii",
    "mask",
    "redact",
    "anonymize",
    "tokenize",
    "privacy",
    "data-protection",
    "gdpr",
    "detector"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lexicon/africa": {
      "types": "./dist/lexicon/africa.d.ts",
      "import": "./dist/lexicon/africa.js",
      "require": "./dist/lexicon/africa.cjs"
    },
    "./lexicon/south-asia": {
      "types": "./dist/lexicon/south-asia.d.ts",
      "import": "./dist/lexicon/south-asia.js",
      "require": "./dist/lexicon/south-asia.cjs"
    },
    "./lexicon/east-asia": {
      "types": "./dist/lexicon/east-asia.d.ts",
      "import": "./dist/lexicon/east-asia.js",
      "require": "./dist/lexicon/east-asia.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "libphonenumber-js": "^1.12.39"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@faker-js/faker": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    }
  }
}
