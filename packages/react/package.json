{
  "name": "@pii-mask/react",
  "version": "0.2.1",
  "description": "React bindings for PII masking. Components and hooks powered by @pii-mask/core.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewithveek/pii-mask.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/codewithveek/pii-mask/issues"
  },
  "homepage": "https://github.com/codewithveek/pii-mask/tree/main/packages/react#readme",
  "keywords": [
    "pii",
    "mask",
    "react",
    "hooks",
    "redact",
    "anonymize",
    "privacy",
    "data-protection",
    "component"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@pii-mask/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.0.18",
    "happy-dom": "^20.8.9",
    "react": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
