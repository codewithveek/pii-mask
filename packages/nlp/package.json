{
  "name": "@pii-mask/nlp",
  "version": "0.2.1",
  "description": "NLP extension for PII masking. Detects names and places using compromise.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codewithveek/pii-mask.git",
    "directory": "packages/nlp"
  },
  "bugs": {
    "url": "https://github.com/codewithveek/pii-mask/issues"
  },
  "homepage": "https://github.com/codewithveek/pii-mask/tree/main/packages/nlp#readme",
  "keywords": [
    "pii",
    "mask",
    "nlp",
    "names",
    "places",
    "compromise",
    "privacy",
    "data-protection",
    "detector"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "compromise": "^14.15.0"
  },
  "peerDependencies": {
    "@pii-mask/core": "workspace:*"
  },
  "devDependencies": {
    "@pii-mask/core": "workspace:*",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
